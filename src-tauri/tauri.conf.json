{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "W3LMN",
  "version": "26.9.0",
  "identifier": "com.w3lmn.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "W3LMN",
        "width": 1100,
        "height": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["nxm"] }
    },
    "shell": {
      "open": true
    }
  },
  "bundle": {
    "category": "Utility",
    "homepage": "https://github.com/<OWNER>/W3LMN",
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
