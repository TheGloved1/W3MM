{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TauriTemplate",
  "version": "26.1.0",
  "identifier": "com.example.tauri-template",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TauriTemplate",
        "width": 900,
        "height": 650,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "category": "Utility",
    "homepage": "https://github.com/<OWNER>/tauri-template",
    "active": true,
    "targets": [
      "msi",
      "deb",
      "appimage",
      "rpm",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
